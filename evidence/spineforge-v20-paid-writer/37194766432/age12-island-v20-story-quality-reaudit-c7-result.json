    "findings": [
      {
        "family": "physical_feasibility",
        "severity": "moderate",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S175"
        ],
        "exact_text": "Arda lunged for the ledge where Nisa waited. She leaned out and hauled; his hand found her wrist",
        "reason": "Bridge fell away beneath him, yet he lunges to a ledge; the mechanics of reaching it are unclear. Nisa was holding the line, then she waits on a ledge."
      },
      {
        "family": "causal_logic",
        "severity": "moderate",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S174",
          "S176",
          "S177"
        ],
        "exact_text": "The tension released. Not the line. Her timing.",
        "reason": "The saving is attributed to Nisa's timing, but no timing was shown; the cut line freed him. The causal claim is unearned."
      },
      {
        "family": "state_continuity",
        "severity": "serious",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S167",
          "S172"
        ],
        "exact_text": "He anchored it to the last living trunk on his side, swung the free end across the gap",
        "reason": "Line anchored to a trunk, yet later it is clipped to his harness and tied to the falling span; the line's attachment state is contradictory."
      },
      {
        "family": "state_continuity",
        "severity": "minor",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S052",
          "S050"
        ],
        "exact_text": "Arda had the light expedition line off his harness",
        "reason": "The line was on his harness at landing, yet the glider's attachment is unspecified; later the glider is described as 'left' tilted although it was steadied."
      },
      {
        "family": "spatial_consistency",
        "severity": "moderate",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S161",
          "S170"
        ],
        "exact_text": "found the great root span still hooked to its far anchor, its near anchors torn loose",
        "reason": "Bridge is described as torn loose on the near side, then 'the trunk anchoring the bridge groaned' mid-crossing; anchor geometry and side of the line are confusing."
      },
      {
        "family": "temporal_consistency",
        "severity": "minor",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S074"
        ],
        "exact_text": "was, presumably, still open",
        "reason": "The hedging is acceptable but the corridor 'light' dimming is established only later; minor timing blur."
      },
      {
        "family": "response_causality",
        "severity": "moderate",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S158",
          "S080"
        ],
        "exact_text": "\"We have to hurry; the wind is picking up,\" he said.",
        "reason": "The wind has just hit the camp earlier; the line is a flat reaction and Nisa's prior alarm already established urgency; the response is slightly disconnected."
      },
      {
        "family": "canon_integrity",
        "severity": "minor",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S183"
        ],
        "exact_text": "Their gliders still lay on the shore",
        "reason": "Nisa's glider landing is never shown, and the line steadying only one glider; plural gliders slightly inconsistent."
      },
      {
        "family": "language_naturalness",
        "severity": "minor",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S042"
        ],
        "exact_text": "felt the wind pass a hand's width above his wing",
        "reason": "A gust passing above a wing is an odd image for dip-and-hold evasion; slightly unnatural."
      },
      {
        "family": "language_naturalness",
        "severity": "minor",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S058"
        ],
        "exact_text": "It was nothing like any pattern he'd ever seen.",
        "reason": "Contradicts 'a hitch he almost recognized' and is redundant."
      },
      {
        "family": "spine_fidelity",
        "severity": "moderate",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S080",
          "S082"
        ],
        "exact_text": "\"That's the promise we made, Arda.",
        "reason": "Spine has Nisa return with news of the dimming light and argue; she leaves with an odd promise reference before any dimming, weakening the planned beat."
      },
      {
        "family": "narrative_coherence",
        "severity": "minor",
        "repair_scope": "LOCAL_REPAIR",
        "span_ids": [
          "S195"
        ],
        "exact_text": "the proof was safely tucked away",
        "reason": "Vague; does not specify the journal and tag are carried, though the ending is meant to emphasize them."
      }
    ],
