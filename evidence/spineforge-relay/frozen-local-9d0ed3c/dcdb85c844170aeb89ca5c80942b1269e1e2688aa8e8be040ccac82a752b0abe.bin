d-event.v1\",\"id\":\"SC06-E03\",\"actor\":\"Ekin_and_Duru\",\"action\":\"RETURN_TOGETHER\",\"target\":\"harbor_via_coastal_route\",\"required_observer\":null,\"satisfaction_mode\":\"ALL_PREDICATES\",\"evidence_mode\":\"DIRECT_OBSERVATION\",\"separate_physical_clue_required\":false,\"predicates\":[{\"id\":\"P1\",\"subject\":\"Ekin_and_Duru\",\"action\":\"RETURN_TOGETHER\",\"target\":\"harbor_via_coastal_route\"},{\"id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"EXIT_VIA\",\"target\":\"open_upper_room_door\"},{\"id\":\"P3\",\"subject\":\"Ekin_and_Duru\",\"action\":\"TRAVERSE\",\"target\":\"established_coastal_path_to_harbor\"}],\"allowed_provenance\":[\"DIRECT_OBSERVATION\"],\"forbidden_provenance\":[\"INVENTED_WORLD_RULE\",\"INVENTED_CLUE\",\"UNESTABLISHED_LORE\"],\"forbidden_evidence_subjects\":[\"secret_route\",\"vehicle\",\"adult_rescuer\",\"internal_narrow_stair\",\"flooded_lower_room\",\"lower_sea_grate\"],\"resulting_state\":{\"/characters/Ekin/location\":\"harbor\",\"/characters/Duru/location\":\"harbor\",\"/characters/Ekin/relationships/Duru/trust\":\"earned\",\"/characters/Duru/relationships/Ekin/trust\":\"earned\"}},{\"schema_name\":\"spineforge-relay.required-event.v1\",\"id\":\"SC06-E04\",\"actor\":\"storm\",\"action\":\"CONTINUE\",\"target\":\"coastal_return\",\"required_observer\":\"Ekin_and_Duru\",\"satisfaction_mode\":\"ALL_PREDICATES\",\"evidence_mode\":\"DIRECT_OBSERVATION\",\"separate_physical_clue_required\":false,\"predicates\":[{\"id\":\"P1\",\"subject\":\"storm\",\"action\":\"CONTINUE\",\"target\":\"coastal_return\"},{\"id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"OBSERVE\",\"target\":\"storm_continues_during_return\"}],\"allowed_provenance\":[\"DIRECT_OBSERVATION\"],\"forbidden_provenance\":[\"INVENTED_WORLD_RULE\",\"INVENTED_CLUE\",\"UNESTABLISHED_LORE\"],\"forbidden_evidence_subjects\":[\"instant_clear_sky\"],\"resulting_state\":{\"/world/weather\":\"storm_active_return_route_passable\"}},{\"schema_name\":\"spineforge-relay.required-event.v1\",\"id\":\"SC06-SPACE\",\"actor\":\"Duru\",\"action\":\"MOVE\",\"target\":\"coastal_path\",\"required_observer\":null,\"satisfaction_mode\":\"ALL_PREDICATES\",\"evidence_mode\":\"DIRECT_OBSERVATION\",\"separate_physical_clue_required\":false,\"predicates\":[{\"id\":\"P1\",\"subject\":\"Duru\",\"action\":\"MOVE\",\"target\":\"coastal_path\"},{\"id\":\"P2\",\"subject\":\"Ekin\",\"action\":\"MOVE\",\"target\":\"coastal_path\"},{\"id\":\"P3\",\"subject\":\"Duru\",\"action\":\"MOVE\",\"target\":\"harbor\"},{\"id\":\"P4\",\"subject\":\"Ekin\",\"action\":\"MOVE\",\"target\":\"harbor\"}],\"allowed_provenance\":[\"DIRECT_OBSERVATION\"],\"forbidden_provenance\":[\"INVENTED_WORLD_RULE\",\"INVENTED_CLUE\",\"UNESTABLISHED_LORE\"],\"forbidden_evidence_subjects\":[],\"resulting_state\":{\"/world/spatial\":{\"topology_sha256\":\"391a1d2dbefdd58af2badc314168178136c5c2dcfb112c2cbb8e3cb5fd57c0ae\",\"positions\":{\"Ekin\":\"harbor\",\"Duru\":\"harbor\",\"sea_dragon\":\"lighthouse_upper_room\",\"dragon_hatchling\":\"lighthouse_upper_room\"},\"access_constraints\":[{\"id\":\"nest_guard\",\"blocker\":\"sea_dragon\",\"subject\":\"Ekin\",\"target\":\"nest_approach\",\"active\":false}]}}}],\"entry_state\":{\"/characters/Ekin/location\":\"lighthouse_upper_room\",\"/characters/Duru/location\":\"lighthouse_upper_room\",\"/objects/dragon_hatchling/location\":\"lighthouse_upper_room\",\"/objects/compass/location\":\"lost_at_sea\",\"/characters/Ekin/relationships/Duru/trust\":\"earned_initial\",\"/characters/Duru/relationships/Ekin/trust\":\"earned_initial\",\"/world/mother_dragon_location\":\"lighthouse_upper_room\",\"/world/spatial\":{\"topology_sha256\":\"391a1d2dbefdd58af2badc314168178136c5c2dcfb112c2cbb8e3cb5fd57c0ae\",\"positions\":{\"Ekin\":\"lighthouse_upper_room\",\"Duru\":\"lighthouse_upper_room\",\"sea_dragon\":\"lighthouse_upper_room\",\"dragon_hatchling\":\"lighthouse_upper_room\"},\"access_constraints\":[{\"id\":\"nest_guard\",\"blocker\":\"sea_dragon\",\"subject\":\"Ekin\",\"target\":\"nest_approach\",\"active\":false}]}},\"required_exit_state\":{\"/characters/Ekin/location\":\"harbor\",\"/characters/Duru/location\":\"harbor\",\"/objects/dragon_hatchling/location\":\"lighthouse_upper_room\",\"/objects/compass/location\":\"lost_at_sea\",\"/characters/Ekin/relationships/Duru/trust\":\"earned\",\"/characters/Duru/relationships/Ekin/trust\":\"earned\",\"/world/weather\":\"storm_active_return_route_passable\",\"/open_threads\":[],\"/resolved_threads\":[\"recover_compass\"],\"/narrative_obligations\":[{\"id\":\"ekin_duru_trust\",\"detail\":\"Trust must change through earned cooperation, not instant friendship.\",\"status\":\"SATISFIED\",\"target_scene_id\":\"SC06\"},{\"id\":\"compass_loss\",\"detail\":\"The compass must ultimately remain lost rather than be replaced by a reward.\",\"status\":\"SATISFIED\",\"target_scene_id\":\"SC06\"}],\"/world/mother_dragon_location\":\"lighthouse_upper_room\",\"/world/spatial\":{\"topology_sha256\":\"391a1d2dbefdd58af2badc314168178136c5c2dcfb112c2cbb8e3cb5fd57c0ae\",\"positions\":{\"Ekin\":\"harbor\",\"Duru\":\"harbor\",\"sea_dragon\":\"lighthouse_upper_room\",\"dragon_hatchling\":\"lighthouse_upper_room\"},\"access_constraints\":[{\"id\":\"nest_guard\",\"blocker\":\"sea_dragon\",\"subject\":\"Ekin\",\"target\":\"nest_approach\",\"active\":false}]}},\"allowed_state_paths\":[],\"immutable_facts\":[\"The compass remains irretrievably lost at sea.\",\"The mother sea dragon does not speak, thank the children, cast magic, or give a reward.\",\"The hatchling is safe in the dry upper room.\",\"The known coastal route remains the return route.\",\"The storm does not suddenly stop.\",\"The mother sea dragon is already inside the lighthouse upper room at scene entry and does not re-enter from outside.\",\"The open upper-room door leads directly to the established coastal path to the harbor.\",\"The internal narrow stair leads from the upper room only to the flooded lower maintenance room; it is not an exterior exit.\",\"The fixed lower sea grate is not a traversable exit for the children.\"],\"forbidden\":[\"Do not recover, replace, duplicate, reward, or magically return the compass.\",\"Do not make the mother dragon speak or understand human morality.\",\"Do not introduce new gear, transport, secret routes, or adult rescue.\",\"Do not end with instant best-friend intimacy or a didactic moral summary.\",\"Do not stop the storm abruptly.\",\"Do not make the mother sea dragon arrive, enter, or re-enter from outside; she is already inside the upper room.\",\"Do not descend the internal narrow stair to leave the lighthouse, use the flooded lower room or grate as an exit, or invent another doorway, route, or passage. Exit through the open upper-room door before returning via the established coastal path.\"],\"emotional_transition\":{\"from\":\"Ekin has begun to trust Duru after shared responsibility\",\"to\":\"Ekin accepts Duru's guidance and the compass loss without erasing either consequence\"},\"target_words_min\":220,\"target_words_max\":360,\"max_rewrites\":1},\"spatial_contract\":{\"schema_name\":\"spineforge-relay.spatial-contract.v1\",\"scene_contract_sha256\":\"7ee974f66dc13f3e944094268798c5ad83db411274bd7fe8c1de570b5c1d26f2\",\"story_state_sha256\":\"25a55a8cfd00330759c8e936bf1c40186dd44af80757464ff7c583e38da8a3e3\",\"topology\":{\"schema_name\":\"spineforge-relay.spatial-topology.v1\",\"locations\":[\"harbor\",\"coastal_path\",\"lighthouse_upper_room\",\"lighthouse_stair_dry_section\",\"lower_room_dry_ledge\"],\"edges\":[{\"id\":\"coast\",\"source\":\"harbor\",\"destination\":\"coastal_path\",\"passage\":\"established_coastal_path\",\"bidirectional\":true,\"allowed_entities\":[\"Ekin\",\"Duru\"]},{\"id\":\"upper_door\",\"source\":\"coastal_path\",\"destination\":\"lighthouse_upper_room\",\"passage\":\"open_upper_room_door\",\"bidirectional\":true,\"allowed_entities\":[\"Ekin\",\"Duru\"]},{\"id\":\"upper_stair\",\"source\":\"lighthouse_upper_room\",\"destination\":\"lighthouse_stair_dry_section\",\"passage\":\"narrow_internal_stair\",\"bidirectional\":true,\"allowed_entities\":[\"Ekin\",\"Duru\",\"dragon_hatchling\"]},{\"id\":\"lower_stair\",\"source\":\"lighthouse_stair_dry_section\",\"destination\":\"lower_room_dry_ledge\",\"passage\":\"dry_stair_to_lower_ledge\",\"bidirectional\":true,\"allowed_entities\":[\"Ekin\",\"Duru\",\"dragon_hatchling\"]}],\"position_state_paths\":{\"Ekin\":\"/characters/Ekin/location\",\"Duru\":\"/characters/Duru/location\",\"sea_dragon\":\"/world/mother_dragon_location\",\"dragon_hatchling\":\"/objects/dragon_hatchling/location\"}},\"entry\":{\"topology_sha256\":\"391a1d2dbefdd58af2badc314168178136c5c2dcfb112c2cbb8e3cb5fd57c0ae\",\"positions\":{\"Ekin\":\"lighthouse_upper_room\",\"Duru\":\"lighthouse_upper_room\",\"sea_dragon\":\"lighthouse_upper_room\",\"dragon_hatchling\":\"lighthouse_upper_room\"},\"access_constraints\":[{\"id\":\"nest_guard\",\"blocker\":\"sea_dragon\",\"subject\":\"Ekin\",\"target\":\"nest_approach\",\"active\":false}]},\"operations\":[{\"id\":\"SC06-S1\",\"kind\":\"MOVE\",\"subject\":\"Duru\",\"target\":\"coastal_path\",\"event_id\":\"SC06-SPACE\",\"predicate_id\":\"P1\",\"edge_id\":\"upper_door\",\"constraint_id\":null},{\"id\":\"SC06-S2\",\"kind\":\"MOVE\",\"subject\":\"Ekin\",\"target\":\"coastal_path\",\"event_id\":\"SC06-SPACE\",\"predicate_id\":\"P2\",\"edge_id\":\"upper_door\",\"constraint_id\":null},{\"id\":\"SC06-S3\",\"kind\":\"MOVE\",\"subject\":\"Duru\",\"target\":\"harbor\",\"event_id\":\"SC06-SPACE\",\"predicate_id\":\"P3\",\"edge_id\":\"coast\",\"constraint_id\":null},{\"id\":\"SC06-S4\",\"kind\":\"MOVE\",\"subject\":\"Ekin\",\"target\":\"harbor\",\"event_id\":\"SC06-SPACE\",\"predicate_id\":\"P4\",\"edge_id\":\"coast\",\"constraint_id\":null}],\"exit\":{\"topology_sha256\":\"391a1d2dbefdd58af2badc314168178136c5c2dcfb112c2cbb8e3cb5fd57c0ae\",\"positions\":{\"Ekin\":\"harbor\",\"Duru\":\"harbor\",\"sea_dragon\":\"lighthouse_upper_room\",\"dragon_hatchling\":\"lighthouse_upper_room\"},\"access_constraints\":[{\"id\":\"nest_guard\",\"blocker\":\"sea_dragon\",\"subject\":\"Ekin\",\"target\":\"nest_approach\",\"active\":false}]}},\"plan_coverage_contract\":{\"schema_name\":\"spineforge-relay.plan-coverage.v1\",\"scene_plan_sha256\":\"e091090753376910e2edf304ddfc0f498acb720e8dead81cfc18376b96b3b4fb\",\"scene_contract_sha256\":\"7ee974f66dc13f3e944094268798c5ad83db411274bd7fe8c1de570b5c1d26f2\",\"obligations\":[{\"id\":\"SC06-narrative_purpose\",\"source_field\":\"narrative_purpose\",\"source_text\":\"Close the adventure without restoring the compass: reunite the hatchling with its mother, return by the known route, and show the earned change between Ekin and Duru.\",\"required_predicates\":[{\"event_id\":\"SC06-E01\",\"predicate_id\":\"P1\",\"subject\":\"sea_dragon\",\"action\":\"SHELTER\",\"target\":\"dragon_hatchling\"},{\"event_id\":\"SC06-E01\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"OBSERVE\",\"target\":\"mother_hatchling_reunited\"},{\"event_id\":\"SC06-E02\",\"predicate_id\":\"P1\",\"subject\":\"Ekin\",\"action\":\"ACCEPT_LOSS\",\"target\":\"compass\"},{\"event_id\":\"SC06-E02\",\"predicate_id\":\"P2\",\"subject\":\"Duru\",\"action\":\"OBSERVE\",\"target\":\"Ekin_accepting_compass_loss\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P1\",\"subject\":\"Ekin_and_Duru\",\"action\":\"RETURN_TOGETHER\",\"target\":\"harbor_via_coastal_route\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"EXIT_VIA\",\"target\":\"open_upper_room_door\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P3\",\"subject\":\"Ekin_and_Duru\",\"action\":\"TRAVERSE\",\"target\":\"established_coastal_path_to_harbor\"},{\"event_id\":\"SC06-E04\",\"predicate_id\":\"P1\",\"subject\":\"storm\",\"action\":\"CONTINUE\",\"target\":\"coastal_return\"},{\"event_id\":\"SC06-E04\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"OBSERVE\",\"target\":\"storm_continues_during_return\"}]},{\"id\":\"SC06-objective\",\"source_field\":\"objective\",\"source_text\":\"Finish the rescue, keep the compass lost, return safely while the storm continues, close the recovery thread, and satisfy the trust and compass-loss obligations.\",\"required_predicates\":[{\"event_id\":\"SC06-E01\",\"predicate_id\":\"P1\",\"subject\":\"sea_dragon\",\"action\":\"SHELTER\",\"target\":\"dragon_hatchling\"},{\"event_id\":\"SC06-E01\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"OBSERVE\",\"target\":\"mother_hatchling_reunited\"},{\"event_id\":\"SC06-E02\",\"predicate_id\":\"P1\",\"subject\":\"Ekin\",\"action\":\"ACCEPT_LOSS\",\"target\":\"compass\"},{\"event_id\":\"SC06-E02\",\"predicate_id\":\"P2\",\"subject\":\"Duru\",\"action\":\"OBSERVE\",\"target\":\"Ekin_accepting_compass_loss\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P1\",\"subject\":\"Ekin_and_Duru\",\"action\":\"RETURN_TOGETHER\",\"target\":\"harbor_via_coastal_route\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"EXIT_VIA\",\"target\":\"open_upper_room_door\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P3\",\"subject\":\"Ekin_and_Duru\",\"action\":\"TRAVERSE\",\"target\":\"established_coastal_path_to_harbor\"},{\"event_id\":\"SC06-E04\",\"predicate_id\":\"P1\",\"subject\":\"storm\",\"action\":\"CONTINUE\",\"target\":\"coastal_return\"},{\"event_id\":\"SC06-E04\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"OBSERVE\",\"target\":\"storm_continues_during_return\"}]},{\"id\":\"SC06-turn\",\"source_field\":\"turn\",\"source_text\":\"Ekin accepts both Duru's guidance and the permanent loss of the compass.\",\"required_predicates\":[{\"event_id\":\"SC06-E02\",\"predicate_id\":\"P1\",\"subject\":\"Ekin\",\"action\":\"ACCEPT_LOSS\",\"target\":\"compass\"},{\"event_id\":\"SC06-E02\",\"predicate_id\":\"P2\",\"subject\":\"Duru\",\"action\":\"OBSERVE\",\"target\":\"Ekin_accepting_compass_loss\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P1\",\"subject\":\"Ekin_and_Duru\",\"action\":\"RETURN_TOGETHER\",\"target\":\"harbor_via_coastal_route\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P2\",\"subject\":\"Ekin_and_Duru\",\"action\":\"EXIT_VIA\",\"target\":\"open_upper_room_door\"},{\"event_id\":\"SC06-E03\",\"predicate_id\":\"P3\",\"subject\":\"Ekin_and_Duru\",\"action\":\"TRAVERSE\",\"target\":\"established_coastal_path_to_harbor\"}]}],\"ordered_dependencies\":[]},\"relevant_character_canon\":{\"Ekin\":{\"age\":12,\"identity\":\"girl\",\"pronouns\":[\"she\",\"her\"]},\"Duru\":{\"age\":12,\"identity\":\"girl\",\"pronouns\":[\"she\",\"her\"]}},\"prop_authorization_policy\":{\"authorized_actionable_props\":[\"compass\",\"Ekin_jacket\"],\"rule\":\"Any newly materialized portable or action-capable physical prop not authorized by StoryState, SceneContract or immutable canon is BLOCKING even if currently used only as scenery. Structural fixed features explicitly required by the contract are allowed.\"},\"candidate_prose\":\"The sea dragon lowered herself around the hatchling, curving her great body between it and the storm. She folded one wing over the little dragon. The hatchling pressed close beneath it, safe and dry.\\n\\nEkin and Duru watched mother and hatchling settle together. Neither girl moved until the hatchling’s trembling stopped.\\n\\nThunder shook the upper room. Ekin looked toward the open door, then out into the rain. Somewhere beyond the headland and the dark sea, her grandfather’s brass compass was gone beyond recovery.\\n\\n“I kept thinking I could still get it back,” she said. Her voice tightened, but she did not turn away. “I can’t. The compass is lost.”\\n\\nDuru watched Ekin accept the words and the hurt behind them. “We should take the coastal path before the rain gets worse.”\\n\\nEkin’s first answer rose sharp in her throat. She swallowed it. Duru had guided her safely before, and Ekin chose to listen now.\\n\\n“All right,” Ekin said. “You lead.”\\n\\nDuru stepped through the open upper-room door and reached the coastal path.\\n\\nEkin stepped through the open upper-room door and reached the coastal path.\\n\\nThey set off together along the established coastal route toward the harbor. The storm continued throughout their return. Rain swept across the path, and thunder rolled over the sea. Both girls saw the storm still raging and kept close enough to watch each other’s footing.\\n\\nWhen the harbor came into view, Duru followed the established coastal path and reached the harbor.\\n\\nEkin followed the established coastal path and reached the harbor.\\n\\nThey stood there together, soaked and tired. Ekin glanced back toward the distant lighthouse. The compass would not return, and she would not pretend its loss did not matter. Then she faced Duru.\\n\\n“I’m glad I didn’t do all of that alone,” she said.\\n\\nDuru gave a small nod. It was not the ease of old friendship, but it was trust they had earned.\",\"deterministic_findings\":[]}"
    }
  ],
