{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "advisory_notes",
    "unresolved_material_issues",
    "summary"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "severity",
          "repair_scope",
          "span_ids",
          "exact_text",
          "reason"
        ],
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "physical_feasibility",
              "causal_logic",
              "state_continuity",
              "epistemic_order",
              "spatial_consistency",
              "temporal_consistency",
              "response_causality",
              "closure_integrity",
              "canon_integrity",
              "language_naturalness",
              "age_suitability",
              "spine_fidelity",
              "narrative_coherence"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "serious",
              "critical"
            ]
          },
          "repair_scope": {
            "type": "string",
            "enum": [
              "SCENE_REPAIR"
            ]
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 16
            },
            "uniqueItems": true
          },
          "exact_text": {
            "type": "string",
            "maxLength": 1200
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "advisory_notes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "unresolved_material_issues": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
