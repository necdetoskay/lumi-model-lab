{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "advisory_notes",
    "unresolved_material_issues",
    "summary",
    "reviewed_requirements"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "severity",
          "repair_scope",
          "span_ids",
          "exact_text",
          "reason",
          "source_requirements",
          "evidence"
        ],
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "physical_feasibility",
              "causal_logic",
              "state_continuity",
              "epistemic_order",
              "spatial_consistency",
              "temporal_consistency",
              "response_causality",
              "closure_integrity",
              "canon_integrity",
              "language_naturalness",
              "age_suitability",
              "spine_fidelity",
              "narrative_coherence"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "serious",
              "critical"
            ]
          },
          "repair_scope": {
            "type": "string",
            "enum": [
              "SCENE_REPAIR"
            ]
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 16
            },
            "uniqueItems": true
          },
          "exact_text": {
            "type": "string",
            "maxLength": 1200
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "source_requirements": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "span_id",
                "quote"
              ],
              "properties": {
                "span_id": {
                  "type": "string",
                  "maxLength": 16
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              }
            }
          }
        }
      }
    },
    "advisory_notes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "unresolved_material_issues": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "reviewed_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 256
      }
    }
  }
}
