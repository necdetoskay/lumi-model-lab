  "finding_count": 12,
  "findings": [
    {
      "family": "physical_feasibility",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S175"
      ],
      "exact_text": "Arda swung free on the line Nisa still held.",
      "reason": "He cut the line away from the bridge while it looped his harness; Nisa holding the line he's swinging on is unclear, and the rescue mechanics conflict."
    },
    {
      "family": "causal_logic",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S175",
        "S179",
        "S180"
      ],
      "exact_text": "\"My line,\" he said.",
      "reason": "Line was cut away, yet Nisa still holds it and hauls him; then the line is declared lost. Contradictory logic about what was cut."
    },
    {
      "family": "state_continuity",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S183"
      ],
      "exact_text": "Their gliders still lay where the old knotted trunk leaned, just as they'd left them.",
      "reason": "Glider was lashed to a trunk and Arda unfastened the line; the gliders' position near knotted trunk is plausible but the line is later lost, and Nisa's glider was never described landing."
    },
    {
      "family": "spatial_consistency",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S159",
        "S160"
      ],
      "exact_text": "They reached the bridge too late.",
      "reason": "Bridge was already torn loose and later they cross it with the line; the 'too late' framing is clear, but 'could no longer carry them' then says it's still sagging above a drop, and the line crossing across the gap is inconsistent with anchor-trunk placement."
    },
    {
      "family": "temporal_consistency",
      "severity": "minor",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S080"
      ],
      "exact_text": "Ten minutes, and we watch the sun; we want to be back before dusk.",
      "reason": "Dusk reference is awkward and introduces a time frame inconsistent with corridor-light urgency; Nisa returns after far less."
    },
    {
      "family": "closure_integrity",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S199"
      ],
      "exact_text": "while the island that had dissolved into the cloud wall lived on in the journal and the tag only he and Nisa could explain.",
      "reason": "Ending ends on an abstract clause instead of the tag image; also claims they can explain the tag, which they cannot."
    },
    {
      "family": "language_naturalness",
      "severity": "minor",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S172"
      ],
      "exact_text": "The bridge was sinking, and the line was still looped around his harness.",
      "reason": "Line was anchored to trunk and held by Nisa; 'looped around his harness' reads awkwardly and conflicts."
    },
    {
      "family": "language_naturalness",
      "severity": "minor",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S173"
      ],
      "exact_text": "he cut the line away from the sinking bridge.",
      "reason": "Line was anchored to a trunk, not the bridge; phrasing is confusing."
    },
    {
      "family": "narrative_coherence",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S158",
        "S159"
      ],
      "exact_text": "\"We have to hurry to the bridge,\" he said.",
      "reason": "Followed by 'too late' with no cause; bridge failure feels unmotivated and the sequence is abrupt."
    },
    {
      "family": "language_naturalness",
      "severity": "minor",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S086"
      ],
      "exact_text": "On the far side of the bridge, from a cliff edge, he could look out",
      "reason": "The stacked opening location phrases create a compressed, awkward spatial construction; stating that he reached the cliff edge makes the position immediately clear."
    },
    {
      "family": "language_naturalness",
      "severity": "minor",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S114"
      ],
      "exact_text": "search it alone",
      "reason": "The pronoun “it” has an imprecise physical referent here. Naming the camp produces the natural English object of “search” and improves immediate clarity."
    },
    {
      "family": "language_naturalness",
      "severity": "moderate",
      "repair_scope": "LOCAL_REPAIR",
      "span_ids": [
        "S175"
      ],
      "exact_text": "She leaned out and hauled, his hand found her wrist",
      "reason": "A comma incorrectly joins two independent clauses, making the rapid action sequence grammatically unstable. A semicolon preserves the pace and clarifies the progression."
    }
