{
  "schema_version": "spineforge-runtime-profile.v1",
  "runtime_id": "spineforge.general.v1",
  "status": "FROZEN_QUALIFICATION_CANDIDATE",
  "purpose": "Produce a production-grade Story Spine product before StoryForge Writer execution.",
  "runtime": {
    "creative_architect_model": "aion-labs/aion-3.5-mini",
    "creative_prompt": "prompts/spineforge_creative_architect_v1.md",
    "hardener_model": "anthropic/claude-sonnet-5.5",
    "hardener_prompt": "prompts/spineforge_structural_hardener_v1.md",
    "product_gate_model": "openai/gpt-5.6-luna",
    "product_gate_prompt": "prompts/spineforge_product_gate_v1.md",
    "max_attempts": 3,
    "max_calls_per_attempt": 3,
    "parse_retry_per_model_call": 0,
    "human_review_required_before_story_writer": true
  },
  "role_ownership": {
    "aion": "creative ownership: premise dramatization, story engine, memorable scenes, roleplay, beats, branch options, climax identity",
    "sonnet": "structural hardening only: bounded deterministic patches or REPLAN; no creative takeover",
    "luna": "independent product gate across creative and structural quality",
    "human": "final Spine Product approval before any Writer call"
  },
  "product_quality_dimensions": [
    "STORY_DESIRE",
    "ROLEPLAY_POTENTIAL",
    "SCENE_POTENTIAL",
    "CHARACTER_DRIVENNESS",
    "WORLD_SPECIFICITY",
    "WONDER_OR_INTRIGUE",
    "AGE_MATURITY",
    "CAUSAL_COHERENCE",
    "ESCALATION",
    "REVERSAL_QUALITY",
    "AGENCY",
    "BRANCH_EXECUTABILITY",
    "CLIMAX_PAYOFF",
    "LOCAL_SATISFACTION",
    "SAGA_ALIGNMENT",
    "WRITER_EXECUTABILITY",
    "FRESHNESS"
  ],
  "recovery_policy": {
    "creative_contract_invalid": "STOP_CURRENT_ATTEMPT; no Sonnet/Luna call; next attempt requires explicit authorization",
    "sonnet_replan": "convert to spineforge-revision-feedback.v1 data; next Aion attempt only after explicit authorization",
    "sonnet_patch": "deterministic exact path patch; patch cannot modify creative identity fields",
    "sonnet_patch_invalid": "STOP_CURRENT_ATTEMPT; no Luna call",
    "luna_replan": "convert blocking reasons to spineforge-revision-feedback.v1 data; next Aion attempt only after explicit authorization",
    "human_revise": "human feedback becomes spineforge-revision-feedback.v1 data; next Aion attempt only after explicit authorization",
    "attempt_limit": "maximum 3 attempts; attempt 4 is rejected before inference"
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_each_spineforge_attempt": true,
    "one_authorized_attempt_scope": "Aion Creative Architect; if valid Sonnet Hardener; if not REPLAN and patches valid Luna Product Gate; then STOP",
    "no_automatic_paid_retry": true,
    "no_writer_call_inside_spineforge": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "case_variation_is_data_only": true,
    "revision_feedback_is_data_only": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true,
    "active_case_may_not_be_reclassified_as_success_after_runtime_patch": true
  },
  "runtime_freeze": {
    "enabled": true,
    "runtime_revision": "SPINEFORGE-FROZEN-v1",
