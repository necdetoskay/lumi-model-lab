{
  "schema_version": "spineforge-runtime-profile.v1",
  "runtime_id": "spineforge.contextpack.v9",
  "status": "FROZEN_QUALIFICATION_CANDIDATE",
  "purpose": "Preserve the v8 generation/evidence architecture while fixing the generic path-insensitive provider JSON Schema sanitizer defect.",
  "runtime": {
    "generation_runtime": "src/spineforge_v9.py",
    "generation_topology_same_as_v8": true,
    "creative_architect_model": "aion-labs/aion-3.5-mini",
    "creative_prompt": "prompts/spineforge_creative_architect_v5_blueprint.md",
    "structural_compiler_model": "anthropic/claude-sonnet-5.5",
    "structural_prompt": "prompts/spineforge_structural_compiler_v7_partitioned.md",
    "product_gate_model": "openai/gpt-5.6-luna",
    "product_gate_prompt": "prompts/spineforge_product_gate_v2_context.md",
    "max_attempts": 3,
    "max_calls_per_attempt": 5,
    "parse_retry_per_model_call": 0,
    "human_review_required_before_story_writer": true
  },
  "strict_transport_policy": {
    "path_aware_schema_sanitizer": true,
    "schema_name_maps_preserve_member_names": [
      "properties",
      "$defs",
      "definitions",
      "patternProperties",
      "dependentSchemas"
    ],
    "required_subset_properties_preflight": true,
    "sonnet_schema_budget_bytes": 4096,
    "provider_strict_schema": true,
    "provider_require_parameters": true,
    "strict_parse_retry": 0
  },
  "evidence_policy": {
    "compact_actions_log_summary_required": true,
    "full_repo_evidence_required": true,
    "repo_evidence_path": "experiments/results/spineforge-v9/<run_id>",
    "artifact_upload": "best_effort_only",
    "artifact_quota_may_not_destroy_primary_evidence": true
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_each_attempt": true,
    "no_automatic_paid_retry": true,
    "no_writer_call_inside_spineforge": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "case_variation_is_data_only": true,
    "revision_feedback_is_data_only": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true
  },
  "runtime_freeze": {
    "enabled": true,
