{
  "schema_version": "spineforge-runtime-profile.v1",
  "runtime_id": "spineforge.contextpack.v4",
  "status": "FROZEN_QUALIFICATION_CANDIDATE",
  "purpose": "Preserve v3 contracts while fixing generic reversal-evidence normalization integrity before paid SpineForge qualification.",
  "context_contract": {
    "schema": "spine-context-pack.v1",
    "qualification_source": "mock-lumi-canonical-state.v1",
    "production_source_target": "LUMI_CANONICAL_STATE",
    "same_pack_for_aion_sonnet_luna": true,
    "model_parity_required": true,
    "stale_revision_rejected": true,
    "stale_human_approval_rejected": true
  },
  "runtime": {
    "creative_architect_model": "aion-labs/aion-3.5-mini",
    "creative_prompt": "prompts/spineforge_creative_architect_v4_context.md",
    "hardener_model": "anthropic/claude-sonnet-5.5",
    "hardener_prompt": "prompts/spineforge_structural_hardener_v2_context.md",
    "product_gate_model": "openai/gpt-5.6-luna",
    "product_gate_prompt": "prompts/spineforge_product_gate_v2_context.md",
    "revision_feedback_schema": "spineforge-revision-feedback.v3",
    "product_schema": "spineforge-product.v3",
    "max_attempts": 3,
    "max_calls_per_attempt": 3,
    "parse_retry_per_model_call": 0,
    "human_review_required_before_story_writer": true,
    "context_materialized_before_each_attempt": true
  },
  "v4_integrity_change": {
    "scope": "NORMALIZER_ONLY_GENERIC_INTEGRITY",
    "reversal_evidence_at_or_before_reversal_is_preserved": true,
    "future_reversal_evidence_may_be_removed_only_when_valid_support_remains": true,
    "application_owned_model_identity": true,
    "logistics_sequence_is_derived_from_ordered_beats": true,
    "no_case_specific_logic": true
  },
  "recovery_policy": {
    "creative_contract_invalid": "STOP current attempt; emit context-bound revision feedback candidate; no downstream call",
    "sonnet_replan": "context-bound revision feedback data -> next explicitly authorized Aion attempt",
    "sonnet_patch": "deterministic bounded exact patch",
    "invalid_patch": "STOP; no Luna call",
    "luna_replan": "context-bound revision feedback data -> next explicitly authorized Aion attempt",
    "human_revise": "context-bound revision feedback data -> next explicitly authorized Aion attempt",
    "context_changed": "STOP before inference; existing feedback/product/approval stale",
    "attempt_limit": "3; attempt 4 rejected before inference"
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_each_attempt": true,
    "one_attempt_scope": "Aion; if valid Sonnet; if eligible Luna; then STOP",
    "no_automatic_paid_retry": true,
    "no_writer_call_inside_spineforge": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "case_variation_is_data_only": true,
    "revision_feedback_is_data_only": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true,
    "active_case_may_not_be_reclassified_as_success_after_runtime_patch": true
  },
  "runtime_freeze": {
    "enabled": true,
