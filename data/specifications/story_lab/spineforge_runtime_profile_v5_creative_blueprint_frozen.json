{
  "schema_version": "spineforge-runtime-profile.v1",
  "runtime_id": "spineforge.contextpack.v5",
  "status": "FROZEN_QUALIFICATION_CANDIDATE",
  "purpose": "Separate Aion creative invention from strict EpisodeSpine compilation so Sonnet owns structural schema completion while preserving creative identity.",
  "context_contract": {
    "schema": "spine-context-pack.v1",
    "qualification_source": "mock-lumi-canonical-state.v1",
    "production_source_target": "LUMI_CANONICAL_STATE",
    "same_pack_for_aion_sonnet_luna": true,
    "model_parity_required": true,
    "stale_revision_rejected": true,
    "stale_human_approval_rejected": true
  },
  "runtime": {
    "creative_architect_model": "aion-labs/aion-3.5-mini",
    "creative_prompt": "prompts/spineforge_creative_architect_v5_blueprint.md",
    "creative_product_schema": "spineforge-creative-blueprint.v2",
    "structural_compiler_model": "anthropic/claude-sonnet-5.5",
    "structural_prompt": "prompts/spineforge_structural_compiler_v5.md",
    "structural_product_schema": "spineforge-structural-assembly.v1",
    "strict_episode_spine_schema": "episode-spine.v2",
    "product_gate_model": "openai/gpt-5.6-luna",
    "product_gate_prompt": "prompts/spineforge_product_gate_v2_context.md",
    "revision_feedback_schema": "spineforge-revision-feedback.v5",
    "product_schema": "spineforge-product.v5",
    "max_attempts": 3,
    "max_calls_per_attempt": 3,
    "parse_retry_per_model_call": 0,
    "human_review_required_before_story_writer": true,
    "context_materialized_before_each_attempt": true
  },
  "ownership_boundary": {
    "aion_owns": "creative identity, dramatic engine, roleplay, scene promises, creative beat intentions, decision/climax/payoff ideas",
    "sonnet_owns": "strict EpisodeSpine compilation, phase completeness, complete beat fields, logistics, evidence, branches, persistence structure",
    "luna_owns": "independent Spine Product quality gate",
    "application_owns": "model identity, ContextPack lineage, deterministic validation, stale-state protection"
  },
  "recovery_policy": {
    "creative_blueprint_invalid": "STOP; context-bound feedback -> next explicitly authorized Aion attempt",
    "structural_assembly_invalid": "STOP; preserve fingerprint-bound Creative Blueprint -> next explicitly authorized Sonnet retry",
    "product_replan_creative": "context-bound feedback -> next explicitly authorized Aion attempt",
    "product_replan_structural": "preserve fingerprint-bound Creative Blueprint -> next explicitly authorized Sonnet retry",
    "context_changed": "STOP before inference; existing feedback/product/approval stale",
    "attempt_limit": "3; attempt 4 rejected before inference"
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_each_attempt": true,
    "one_attempt_scope": "Aion if creative stage required; Sonnet if blueprint valid/preserved; Luna if strict spine valid; then STOP",
    "no_automatic_paid_retry": true,
    "no_writer_call_inside_spineforge": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "case_variation_is_data_only": true,
    "revision_feedback_is_data_only": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true,
    "active_case_may_not_be_reclassified_as_success_after_runtime_patch": true
  },
  "runtime_freeze": {
    "enabled": true,
