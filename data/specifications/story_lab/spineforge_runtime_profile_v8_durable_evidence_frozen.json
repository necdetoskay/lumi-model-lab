    "parse_retry_per_model_call": 0,
    "durable_checkpoint_after_every_completed_call": true,
    "human_review_required_before_story_writer": true
  },
  "evidence_policy": {
    "compact_actions_log_summary_required": true,
    "compact_log_excludes_raw_creative_payloads": true,
    "full_repo_evidence_required": true,
    "repo_evidence_path": "experiments/results/spineforge-v8/<run_id>",
    "artifact_upload": "best_effort_only",
    "artifact_quota_may_not_destroy_primary_evidence": true,
    "evidence_persist_failure_makes_workflow_fail": true
  },
  "ownership_boundary": {
    "aion_owns": "creative identity and Creative Blueprint",
    "sonnet_owns": "partitioned strict structural compilation across frame, beats and resolution",
    "luna_owns": "independent Spine Product quality gate",
    "application_owns": "ContextPack authority, assembly, full validation, checkpoints, durable evidence and human approval"
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_each_attempt": true,
    "no_automatic_paid_retry": true,
    "no_writer_call_inside_spineforge": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "case_variation_is_data_only": true,
    "revision_feedback_is_data_only": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true
  },
