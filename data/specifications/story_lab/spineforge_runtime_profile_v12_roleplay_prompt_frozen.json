{
  "schema_version": "spineforge-runtime-profile.v1",
  "runtime_id": "spineforge.contextpack.v12",
  "status": "FROZEN_QUALIFICATION_CANDIDATE",
  "purpose": "Prompt-hardened single-owner Sonnet roleplay-first Episode Spine generation with deterministic authority validation and independent aggressive Sonnet audit.",
  "runtime": {
    "generation_runtime": "src/spineforge_v12.py",
    "spine_architect_model": "anthropic/claude-sonnet-5.5",
    "architect_prompt": "prompts/spineforge_roleplay_architect_v12.md",
    "spine_auditor_model": "anthropic/claude-sonnet-5.5",
    "audit_prompt": "prompts/spineforge_roleplay_auditor_v12.md",
    "architect_request_class": "saga_architect",
    "audit_request_class": "editorial_audit",
    "architect_max_tokens": 11000,
    "audit_max_tokens": 4500,
    "max_calls_per_attempt": 2,
    "parse_retry_per_model_call": 0,
    "automatic_repair_enabled": false,
    "human_review_required_before_story_writer": true
  },
  "prompt_hardening_policy": {
    "explicit_role_and_mission": true,
    "authority_order": true,
    "instruction_boundary": true,
    "story_first_contract_second": true,
    "roleplay_density": true,
    "active_protagonist": true,
    "sceneability": true,
    "character_specificity": true,
    "world_specificity": true,
    "creative_ambition": true,
    "age_maturity": true,
    "causality": true,
    "escalation": true,
    "evidence_discipline": true,
    "reversal_quality": true,
    "decision_quality": true,
    "earned_climax": true,
    "local_payoff": true,
    "saga_discipline": true,
    "field_level_output_guide": true,
    "bad_examples_and_corrections": true,
    "anti_pattern_library": true,
    "silent_self_red_team": true,
    "qualification_case_example_leak_forbidden": true
  },
  "transport_policy": {
    "provider_strict_json_schema": false,
    "json_object_transport": true,
    "local_episode_spine_validation": true,
    "local_audit_contract_validation": true,
    "provider_grammar_size_not_used": true
  },
  "evidence_policy": {
    "full_repo_evidence_required": true,
    "repo_evidence_path": "experiments/results/spineforge-v12/<run_id>",
    "artifact_upload": "best_effort_only",
    "artifact_quota_may_not_destroy_primary_evidence": true,
    "exact_token_cost_latency_required": true
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_attempt_1": true,
    "no_automatic_paid_retry": true,
    "no_automatic_repair": true,
    "no_writer_call_inside_spineforge": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true
  },
  "runtime_freeze": {
