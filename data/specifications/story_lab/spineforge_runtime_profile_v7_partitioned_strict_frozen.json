{
  "schema_version": "spineforge-runtime-profile.v1",
  "runtime_id": "spineforge.contextpack.v7",
  "status": "FROZEN_QUALIFICATION_CANDIDATE",
  "purpose": "Preserve Aion creative ownership while partitioning Sonnet strict structural compilation into provider-safe sections with durable per-call accounting and artifact-based evidence.",
  "context_contract": {
    "schema": "spine-context-pack.v1",
    "qualification_source": "mock-lumi-canonical-state.v1",
    "production_source_target": "LUMI_CANONICAL_STATE",
    "same_pack_for_all_models": true,
    "stale_revision_rejected": true,
    "stale_human_approval_rejected": true
  },
  "runtime": {
    "creative_architect_model": "aion-labs/aion-3.5-mini",
    "creative_prompt": "prompts/spineforge_creative_architect_v5_blueprint.md",
    "creative_product_schema": "spineforge-creative-blueprint.v2",
    "creative_transport": "json_object_plus_local_validation",
    "structural_compiler_model": "anthropic/claude-sonnet-5.5",
    "structural_prompt": "prompts/spineforge_structural_compiler_v7_partitioned.md",
    "structural_sections": [
      "spineforge-structural-frame.v1",
      "spineforge-structural-beats.v1",
      "spineforge-structural-resolution.v1"
    ],
    "structural_transport": "partitioned_provider_strict_shape_schema_plus_full_local_validation",
    "structural_transport_schema_budget_bytes": 4096,
    "strict_episode_spine_schema": "episode-spine.v2",
    "product_gate_model": "openai/gpt-5.6-luna",
    "product_gate_prompt": "prompts/spineforge_product_gate_v2_context.md",
    "product_gate_schema": "spineforge-product-gate.v1",
    "product_gate_transport": "provider_strict_json_schema_plus_local_validation",
    "revision_feedback_schema": "spineforge-revision-feedback.v7",
    "product_schema": "spineforge-product.v7",
    "max_attempts": 3,
    "max_calls_per_attempt": 5,
    "parse_retry_per_model_call": 0,
    "durable_checkpoint_after_every_completed_call": true,
    "partial_evidence_on_downstream_failure": true,
    "evidence_archive": "github_actions_artifact",
    "human_review_required_before_story_writer": true,
    "context_materialized_before_each_attempt": true
  },
  "ownership_boundary": {
    "aion_owns": "creative identity, dramatic engine, roleplay, scene promises, creative beat intentions, decision/climax/payoff ideas",
    "sonnet_owns": "partitioned structural compilation and hardening across frame, beats, and resolution",
    "luna_owns": "independent Spine Product quality gate",
    "application_owns": "ContextPack lineage, deterministic authority fields, section assembly, full semantic/cross-field validation, accounting checkpoints, stale-state protection"
  },
  "strict_transport_policy": {
    "aion_provider_strict_schema": false,
    "sonnet_provider_strict_schema": true,
    "luna_provider_strict_schema": true,
    "strict_flag": true,
    "provider_require_parameters": true,
    "provider_enforces": "shape_required_fields_additional_properties",
    "local_pydantic_enforces": "full_semantics_literals_enums_ranges_patterns_cross_field_authority",
    "sonnet_transport_schema_sizes_bytes": {
      "structural_frame": 1431,
      "structural_beats": 856,
      "structural_resolution": 2891
    },
    "sonnet_transport_schema_budget_bytes": 4096,
    "v6_monolithic_schema_bytes": 8675,
    "strict_parse_retry": 0
  },
  "recovery_policy": {
    "creative_blueprint_invalid": "STOP; context-bound feedback -> next explicitly authorized Aion attempt",
    "structural_frame_invalid": "STOP; preserve ContextPack-bound Creative Blueprint -> next explicitly authorized frame retry",
    "structural_beats_invalid": "STOP; preserve Blueprint + Frame -> next explicitly authorized beats retry",
    "structural_resolution_invalid": "STOP; preserve Blueprint + Frame + Beats -> next explicitly authorized resolution retry",
    "assembled_spine_invalid": "STOP; restart structural compilation on next explicit attempt",
    "context_changed": "STOP before inference; existing feedback/product/approval stale",
    "attempt_limit": "3; attempt 4 rejected before inference"
  },
  "paid_boundary_policy": {
    "explicit_authorization_required_for_each_attempt": true,
    "no_automatic_paid_retry": true,
    "no_writer_call_inside_spineforge": true,
    "evidence_archive_does_not_push_branch": true
  },
  "no_code_change_qualification_rule": {
    "enabled": true,
    "first_paid_case_starts_only_after_runtime_freeze": true,
    "case_variation_is_data_only": true,
    "revision_feedback_is_data_only": true,
    "runtime_hash_mismatch_invalidates_active_case": true,
    "runtime_or_prompt_change_requires_new_spineforge_revision": true,
    "scenario_specific_runtime_patch_counts_as_case_failure": true
  },
  "runtime_freeze": {
