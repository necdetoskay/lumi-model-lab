{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/schemas/character-narrative-blueprint.v1.schema.json",
  "title": "LUMI Character Narrative Blueprint v1",
  "description": "Strict structural schema. Cross-reference and semantic invariants are additionally enforced by src.saga_blueprint_contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "character-narrative-blueprint.v1"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "present_situation": {
      "$ref": "#/$defs/PresentSituation"
    },
    "narrative_core": {
      "$ref": "#/$defs/NarrativeCore"
    },
    "saga_blueprint": {
      "$ref": "#/$defs/SagaBlueprint"
    },
    "world_integration": {
      "$ref": "#/$defs/WorldIntegration"
    },
    "reweave_policy": {
      "$ref": "#/$defs/ReweavePolicy"
    },
    "safety_and_constraints": {
      "$ref": "#/$defs/SafetyAndConstraints"
    }
  },
  "required": [
    "schema",
    "origin",
    "present_situation",
    "narrative_core",
    "saga_blueprint",
    "world_integration",
    "reweave_policy",
    "safety_and_constraints"
  ],
  "$defs": {
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "WORLD_FACT",
            "CHARACTER_FACT",
            "RELATIONSHIP",
            "LOCATION",
            "ITEM",
            "KNOWLEDGE",
            "EVENT"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "reference",
        "condition"
      ]
    },
    "Conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "any_of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "must_not": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      },
      "required": [
        "all_of",
        "any_of",
        "must_not"
      ]
    },
    "OriginFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "enum": [
            "CORE",
            "SUPPORTING"
          ]
        },
        "mutability": {
          "type": "string",
          "enum": [
            "IMMUTABLE",
            "REINTERPRETABLE"
          ]
        },
        "known_by_character": {
          "type": "boolean"
        },
        "known_by_world": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "fact",
        "importance",
        "mutability",
        "known_by_character",
        "known_by_world"
      ]
    },
    "FormativeEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "age_or_period": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "related_origin_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "key",
        "summary",
        "age_or_period",
        "impact",
        "related_origin_facts"
      ]
    },
    "OriginRelationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1
        },
        "historical_role": {
          "type": "string",
          "minLength": 1
        },
        "current_status": {
          "type": "string",
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "LOST",
            "DISTANT",
            "ACTIVE",
            "UNCERTAIN"
          ]
        },
        "unresolved_tension": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "subject",
        "relationship_type",
        "historical_role",
        "current_status",
        "unresolved_tension"
      ]
    },
    "OriginQuestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "enum": [
            "MAJOR",
            "MINOR"
          ]
        },
        "character_knows_question_exists": {
          "type": "boolean"
        },
        "answer_predefined": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "question",
        "importance",
        "character_knows_question_exists",
        "answer_predefined"
      ]
    },
    "Origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "origin_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OriginFact"
          }
        },
        "formative_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormativeEvent"
          }
        },
        "origin_relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OriginRelationship"
          }
        },
        "unresolved_origin_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OriginQuestion"
          }
        }
      },
      "required": [
        "summary",
        "origin_facts",
        "formative_events",
        "origin_relationships",
        "unresolved_origin_questions"
      ]
    },
    "PresentSituation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "current_role": {
          "type": "string",
          "minLength": 1
        },
        "current_location_context": {
          "type": "string",
          "minLength": 1
        },
        "current_relationship_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_pressures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "immediate_desires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "immediate_avoidances": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "summary",
        "current_role",
        "current_location_context",
        "current_relationship_context",
        "current_resources",
        "current_pressures",
        "current_open_questions",
        "immediate_desires",
        "immediate_avoidances"
      ]
    },
    "IdentityAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "statement"
      ]
    },
    "CoreDrive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "drive": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "SECONDARY"
          ]
        }
      },
      "required": [
        "key",
        "drive",
        "strength"
      ]
    },
    "CoreFear": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "fear": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "fear"
      ]
    },
    "InternalTension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "side_a": {
          "type": "string",
          "minLength": 1
        },
        "side_b": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "side_a",
        "side_b",
        "description"
      ]
    },
    "LongTermQuestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "must_be_answered": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "question",
        "must_be_answered"
      ]
    },
    "NarrativeCore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IdentityAnchor"
          }
        },
        "core_drives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoreDrive"
          }
        },
        "core_fears": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoreFear"
          }
        },
        "internal_tensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InternalTension"
          }
        },
        "long_term_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LongTermQuestion"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "identity_anchors",
        "core_drives",
        "core_fears",
        "internal_tensions",
        "long_term_questions",
        "themes"
      ]
    },
    "DesignIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "const": "LONG"
        },
        "breadth": {
          "const": "EXPANSIVE"
        },
        "linear_story_plan": {
          "const": false
        },
        "mandatory_story_order": {
          "const": false
        },
        "user_may_ignore_saga": {
          "const": true
        }
      },
      "required": [
        "horizon",
        "breadth",
        "linear_story_plan",
        "mandatory_story_order",
        "user_may_ignore_saga"
      ]
    },
    "CharacterRelevance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "affected_drives": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "affected_tensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "why_it_matters",
        "affected_drives",
        "affected_tensions"
      ]
    },
    "WorldBindingHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_scope": {
          "type": "string",
          "enum": [
            "LOCAL",
            "REGIONAL",
            "WORLD",
            "CROSS_WORLD"
          ]
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "NPC",
            "LOCATION",
            "ITEM",
            "EVENT",
            "RUMOR",
            "DOCUMENT",
            "NONE"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "preferred_scope",
        "entity_type",
        "description"
      ]
    },
    "VisibilityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_visibility": {
          "type": "string",
          "enum": [
            "HIDDEN",
            "FORESHADOW_ONLY",
            "DISCOVERABLE"
          ]
        },
        "allowed_usage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_usage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reveal_ceiling": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "initial_visibility",
        "allowed_usage",
        "forbidden_usage",
        "reveal_ceiling"
      ]
    },
    "Seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "RUMOR",
            "NPC",
            "LOCATION",
            "ITEM",
            "DOCUMENT",
            "SYMBOL",
            "MEMORY",
            "EVENT",
            "DREAM",
            "RELATIONSHIP",
            "WORLD_PHENOMENON"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "narrative_function": {
          "type": "string",
          "enum": [
            "FORESHADOW",
            "QUESTION",
            "DISCOVERY",
            "CONNECTION",
            "WARNING",
            "TEMPTATION",
            "REVELATION_PRECURSOR"
          ]
        },
        "world_binding_hint": {
          "$ref": "#/$defs/WorldBindingHint"
        },
        "visibility_policy": {
          "$ref": "#/$defs/VisibilityPolicy"
        },
        "eligibility_conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "may_unlock": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "must_not_force_followup": {
          "const": true
        }
      },
      "required": [
        "key",
        "kind",
        "summary",
        "narrative_function",
        "world_binding_hint",
        "visibility_policy",
        "eligibility_conditions",
        "may_unlock",
        "must_not_force_followup"
      ]
    },
    "Milestone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "DISCOVERY",
            "REVELATION",
            "DECISION",
            "RELATIONSHIP_SHIFT",
            "CONSEQUENCE",
            "CONVERGENCE",
            "TRANSFORMATION"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "preconditions": {
          "$ref": "#/$defs/Conditions"
        },
        "possible_entry_points": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "possible_consequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unlocks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "type",
        "summary",
        "required",
        "preconditions",
        "possible_entry_points",
        "possible_consequences",
        "unlocks",
        "terminal"
      ]
    },
    "BranchPath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "description"
      ]
    },
    "Branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BranchPath"
          }
        },
        "all_paths_valid": {
          "const": true
        }
      },
      "required": [
        "key",
        "trigger",
        "paths",
        "all_paths_valid"
      ]
    },
    "PossiblePayoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "certainty": {
          "const": "POSSIBLE"
        },
        "required": {
          "const": false
        }
      },
      "required": [
        "key",
        "description",
        "certainty",
        "required"
      ]
    },
    "DormancyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "may_remain_dormant": {
          "const": true
        },
        "maximum_story_gap": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_periodic_reminder": {
          "const": false
        }
      },
      "required": [
        "may_remain_dormant",
        "maximum_story_gap",
        "requires_periodic_reminder"
      ]
    },
    "RecoveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_reconnect_after_long_absence": {
          "const": true
        },
        "reconnection_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "WORLD_EVENT",
              "NPC",
              "ITEM",
              "RUMOR",
              "LOCATION",
              "CONSEQUENCE"
            ]
          }
        }
      },
      "required": [
        "can_reconnect_after_long_absence",
        "reconnection_methods"
      ]
    },
    "SagaThread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "premise": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "enum": [
            "MAJOR",
            "SUPPORTING",
            "LATENT"
          ]
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "origin_links": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "character_relevance": {
          "$ref": "#/$defs/CharacterRelevance"
        },
        "activation": {
          "$ref": "#/$defs/Conditions"
        },
        "seeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Seed"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Milestone"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Branch"
          }
        },
        "possible_payoffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PossiblePayoff"
          }
        },
        "dormancy_policy": {
          "$ref": "#/$defs/DormancyPolicy"
        },
        "recovery_policy": {
          "$ref": "#/$defs/RecoveryPolicy"
        }
      },
      "required": [
        "key",
        "title",
        "premise",
        "importance",
        "themes",
        "origin_links",
        "character_relevance",
        "activation",
        "seeds",
        "milestones",
        "branches",
        "possible_payoffs",
        "dormancy_policy",
        "recovery_policy"
      ]
    },
    "CrossThreadLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "relationship": {
