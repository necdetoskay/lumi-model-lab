{
  "schema_version": "story-failure-pattern-registry.v0.1",
  "status": "experimental",
  "compilation_order": [
    "global",
    "language",
    "exact_age_or_age_band",
    "story_type",
    "model_specific"
  ],
  "severity": [
    "BLOCKER",
    "SERIOUS",
    "MODERATE",
    "MINOR"
  ],
  "runtime_policy": {
    "whole_registry_in_prompt": false,
    "full_rewrite_for_local_defects": false,
    "final_veto_blocks": [
      "BLOCKER",
      "unresolved_SERIOUS",
      "canon_or_knowledge_contradiction",
      "nonsensical_physical_action",
      "unusable_language",
      "hard_length_violation"
    ],
    "minor_style_preference_is_veto": false
  },
  "initial_patterns": [
    {
      "id": "FP-TR-001",
      "family": "adult_abstract_narrator_register",
      "scope": {
        "language": [
          "tr"
        ],
        "age": [
          "early-child",
          "child"
        ]
      },
      "default_severity": "SERIOUS"
    },
    {
      "id": "FP-TR-002",
      "family": "literary_register_mismatch",
      "scope": {
        "language": [
          "tr"
        ],
        "age": [
          "early-child"
        ]
      },
      "default_severity": "MODERATE"
    },
    {
      "id": "FP-AGE-001",
      "family": "child_reasoning_too_adult",
      "scope": {
        "age": [
          "exact-age-sensitive"
        ]
      },
      "default_severity": "SERIOUS"
    },
    {
      "id": "FP-DIALOGUE-001",
      "family": "adult_teacher_examiner_voice",
      "scope": {
        "age": [
          "early-child",
          "child"
        ]
      },
      "default_severity": "SERIOUS"
    },
    {
      "id": "FP-DIDACTIC-001",
      "family": "story_becomes_lesson",
      "scope": {
        "age": [
          "early-child",
          "child"
        ]
      },
      "default_severity": "SERIOUS"
    },
    {
      "id": "FP-PROSE-001",
      "family": "repeated_syntactic_template",
      "scope": {
        "global": true
      },
      "default_severity": "MODERATE"
    },
    {
      "id": "FP-PROSE-002",
      "family": "defensive_over_explanation",
      "scope": {
        "global": true
      },
      "default_severity": "MODERATE"
    },
    {
      "id": "FP-PHYS-001",
      "family": "awkward_or_impossible_physical_action",
      "scope": {
        "global": true
      },
      "default_severity": "BLOCKER_IF_NONSENSE"
