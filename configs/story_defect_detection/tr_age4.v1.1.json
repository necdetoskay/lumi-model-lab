    "pairwise_order_swap_is_not_sufficient_calibration": true,
    "position_format_length_and_identity_perturbation_tests_required": true,
    "deterministic_checks_preferred_when_possible": true,
    "generator_mutation_during_detector_qualification_forbidden": true
