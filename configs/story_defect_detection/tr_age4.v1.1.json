    "STRUCTURAL_REPAIR",
    "REPLAN"
  ],
  "jev_sentinel": {
    "model_id": "typesafe/jev-1.13",
    "transport": "openrouter_decisions_api",
    "role": "advisory_high_recall_semantic_sentinel",
    "atomic_questions": true,
    "one_global_story_quality_question_forbidden": true,
    "clean_bypass_allowed": false,
    "threshold_status": "UNQUALIFIED",
    "threshold_source": "must_be_learned_from_frozen_lumi_defect_corpus",
    "qualification_behavior": "record_scores_and_escalate_without_granting_clean_authority"
  },
  "strong_verifier": {
    "role": "defect_confirmation_and_location",
    "required_until_jev_calibrated": true,
    "must_return": [
      "family",
      "severity",
      "span_ids",
      "reason",
      "repair_scope"
    ],
    "may_not_rewrite_story": true
  },
  "repair_policy": {
    "minimal_change_required": true,
    "local_repair_only_when_downstream_causal_state_unchanged": true,
    "structural_repair_when_multiple_dependencies_change": true,
    "replan_when_main_causal_chain_or_solution_principle_is_invalid": true,
    "repair_may_not_create_new_canon": true,
    "post_repair_same_defect_verification_required": true,
    "post_repair_regression_verification_required": true
  },
  "benchmark": {
    "corpus_status": "D1_VALIDATED_203_CASES_PLUS_14_CLEAN_SOURCES",
    "target_min_total_cases": 200,
    "target_min_positive_cases_per_priority_family": 20,
    "primary_metric": "serious_critical_recall",
    "secondary_metrics": [
      "critical_recall",
      "per_family_recall",
      "precision",
      "false_negative_count",
      "span_locator_recall",
      "harmful_repair_rate",
      "repair_success_rate",
      "verification_cost_per_accepted_story"
    ],
    "provisional_targets": {
      "critical_recall_min": 1,
      "serious_critical_recall_min": 0.98,
      "physical_and_causal_logic_recall_min": 0.99,
      "harmful_repair_rate_max": 0.01
    },
    "promotion_note": "Targets remain unchanged. Taxonomy v1.1 only changes qualification grouping: response_causality is evaluated as a causal_logic subtype while raw diagnostic labels remain preserved.",
    "priority_family_validated_counts": {
      "physical_feasibility": 42,
      "causal_logic_including_response_causality": 53,
      "state_continuity": 39
    }
  },
  "governance": {
